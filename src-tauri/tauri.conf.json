{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chadoodle",
  "mainBinaryName": "Chadoodle",
  "version": "../package.json",
  "identifier": "de.rbenz.moodledesktop",
  "build": {
    "frontendDist": "../tauri/dist",
    "beforeBuildCommand": "npm run tauri:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Roman Benz",
    "copyright": "© 2026 Roman Benz",
    "shortDescription": "Chadoodle",
    "longDescription": "Desktop-App für Moodle-Kurse mit lokaler Hintergrund-Synchronisation, PDF-Viewer, Volltextsuche und KI-Lernassistent",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh",
        "startMenuFolder": ""
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQjVCNzlGQUQ3OTgyMzIKUldReWdubXRuN2UxUFl3dFN5SjV2OEN2NGU2TDhPaDgvakVnREE0alRMb2xPSHBQMG1BTWVrSVEK",
      "endpoints": ["https://github.com/roman-benz/campus-sync/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}

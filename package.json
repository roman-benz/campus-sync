{
  "name": "moodle-desktop",
  "productName": "Moodle Desktop",
  "version": "1.1.0",
  "description": "Moodle Desktop-App mit lokaler Hintergrund-Synchronisation, PDF-Viewer, Volltextsuche und KI-Lernassistent (ChatGPT oder Claude)",
  "main": "src/main/main.js",
  "author": "Roman Benz",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis --publish never",
    "demo": "electron scripts/demo.js",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "openai": "^7.28.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.rbenz.moodledesktop",
    "productName": "Moodle Desktop",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moodle Desktop",
      "artifactName": "MoodleDesktop-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "roman-benz",
        "repo": "moodle-desktop",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roman-benz/moodle-desktop.git"
  },
  "homepage": "https://github.com/roman-benz/moodle-desktop"
}
